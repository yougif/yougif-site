---
import BaseLayout from "../layouts/BaseLayout.astro";
import { channels } from "../data/yougif";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const channelByLabel = new Map(channels.map((channel) => [channel.label, channel]));
const relayYoutube = channelByLabel.get("Relay Vanguard YouTube");
const relayX = channelByLabel.get("Relay Vanguard X");
const instagram = channelByLabel.get("Instagram");

const heroImage = `${base}assets/media/relay-thumbnail.png`;
const logoImage = `${base}assets/media/relay-vanguard-logo.png`;
const posterImage = `${base}assets/media/relay-final-a4.jpg`;
const shortsImage = `${base}assets/media/relay-example-shorts.png`;
const characterImage = `${base}assets/media/relay-vanguard-character.png`;

const promotionLinks = [
  relayYoutube
    ? ["YouTube", "팀 훈련 영상과 Shorts", relayYoutube.href]
    : null,
  relayX
    ? ["X", "훈련 공지와 활동 기록", relayX.href]
    : null,
  ["Shorts", "자동화로 만든 훈련 하이라이트", "https://www.youtube.com/shorts/4ZHtmbQDv18"],
  instagram
    ? ["Instagram", "Reels와 팀 비주얼", instagram.href]
    : null
].filter(Boolean);

const teamMembers = [
  {
    role: "팀장",
    name: "유기프",
    body:
      "Relay Vanguard 운영, 방송 세팅, 녹화본 정리, Shorts/Reels 검수 흐름을 맡는다. VRChat 안에서 훈련과 방송이 자연스럽게 이어지게 만드는 쪽에 집중한다.",
    href: "https://x.com/vrc_yougif",
    cta: "유기프 X"
  },
  {
    role: "부팀장",
    name: "yeonmuzi_연무지",
    body:
      "훈련 포스터 방향과 팀 비주얼의 중심 인물. 초보자도 들어오기 쉬운 연습 분위기와 Relay Vanguard의 팀 이미지를 함께 잡는다.",
    href: relayX?.href ?? "https://x.com/relay_vanguard",
    cta: "팀 X"
  },
  {
    role: "팀원",
    name: "Katinor Rayner",
    body:
      "VRC Boxing 훈련과 팀 활동에 함께 참여하는 Relay Vanguard 멤버. 팀 공지와 활동 기록은 X를 통해 이어서 확인할 수 있다.",
    href: "https://x.com/KatinorRayner",
    cta: "Katinor X"
  },
  {
    role: "팀원",
    name: "vrcBinMaen",
    body:
      "Relay Vanguard 훈련과 팀 활동에 함께하는 멤버. VRC Boxing 방송팀의 활동 기록과 연결되는 개인 X 계정을 함께 안내한다.",
    href: "https://x.com/vrcBinMaen",
    cta: "vrcBinMaen X"
  },
  {
    role: "팀원",
    name: "aosorasiho",
    body:
      "Relay Vanguard 팀 활동에 함께하는 멤버. 훈련 공지와 팀 활동 흐름은 Relay Vanguard X와 개인 X 링크로 이어서 확인할 수 있다.",
    href: "https://x.com/aosorasiho",
    cta: "aosorasiho X"
  },
  {
    role: "팀원",
    name: "Rebinoa",
    body:
      "Relay Vanguard 팀 활동과 VRC Boxing 흐름에 함께하는 멤버. X 게시글을 통해 실제 활동 기록도 함께 연결한다.",
    href: "https://x.com/Rebinoa_Phesyu",
    cta: "Rebinoa X"
  }
];

const vrcBoxingPoints = [
  "VRChat 안에서 몸을 움직이며 펀치, 가드, 거리 조절을 겨루는 VR 복싱 콘텐츠다.",
  "단순 게임 플레이가 아니라 체력, 리듬, 매너, 공간 감각이 같이 필요한 활동이다.",
  "방송에서는 스파링 장면, 훈련 피드백, 참가자 반응이 Shorts/Reels 소재로 이어진다."
];

const foundingReasons = [
  "한국어로 꾸준히 설명하고 초보자를 받아주는 VRC Boxing 팀이 더 필요하다고 봤다.",
  "큰 대회나 이벤트만 기다리지 않고, 평소 훈련과 짧은 하이라이트가 계속 쌓이는 구조를 만들고 싶었다.",
  "유기프 방송, Relay Vanguard 팀 채널, X 공지, Shorts 자동화를 하나의 운영 루프로 묶기 위해 시작했다."
];

const operatingLoop = [
  ["01", "공지", "X에서 훈련 시간, 참여 방식, 방송 가능 여부를 짧게 알린다."],
  ["02", "입장", "VRChat Group+ 인스턴스에서 매너와 방송 동의 기준을 먼저 확인한다."],
  ["03", "훈련", "짧은 펀치, 빠른 복귀, 가드 유지처럼 좁은 공간에서도 가능한 동작을 반복한다."],
  ["04", "스파링", "초보자와 숙련자가 섞일 때는 세게 이기는 것보다 피드백 가능한 장면을 만든다."],
  ["05", "편집", "녹화본에서 좋은 장면을 골라 YouTube Shorts, Instagram Reels, X 기록으로 남긴다."]
];

const examples = [
  {
    label: "YouTube Shorts",
    title: "훈련 장면을 세로 숏츠로 검수",
    body: "로컬 녹화본에서 20초 안팎 구간을 뽑고, 모바일에서 읽히는 자막과 1080x1920 세로 화면으로 정리한다.",
    image: shortsImage,
    href: "https://www.youtube.com/shorts/4ZHtmbQDv18",
    cta: "Shorts 보기"
  },
  {
    label: "X Notice",
    title: "정기 연습회 공지",
    body: "언제, 어디서, 어떤 방식으로 들어오면 되는지 먼저 보이게 한다. 모집 글은 길게 설명하기보다 바로 행동할 수 있게 쓴다.",
    image: posterImage,
    href: "https://x.com/relay_vanguard/status/2037382268763992209",
    cta: "X 공지 보기"
  },
  {
    label: "Team Visual",
    title: "로고와 방송 비주얼",
    body: "방패 로고, 포스터, 썸네일, Shorts 화면을 같은 톤으로 묶어 Relay Vanguard라는 팀 이름이 반복해서 남게 만든다.",
    image: logoImage,
    href: relayX?.href ?? "https://x.com/relay_vanguard",
    cta: "팀 X 보기"
  },
  {
    label: "Member Post",
    title: "Rebinoa 활동 기록",
    body: "팀원 게시글도 Relay Vanguard의 실제 활동 흐름을 보여주는 자료로 연결한다.",
    image: logoImage,
    href: "https://x.com/Rebinoa_Phesyu/status/2062000967281942741?s=20",
    cta: "Rebinoa 글 보기"
  }
];

const contacts = [
  ["VRChat", "yougif 계정으로 문의", "VRChat에서 유기프에게 직접 문의"],
  ["Discord", "디스코드 문의", "Relay Vanguard X DM 또는 VRChat에서 유기프에게 디스코드 문의"],
  ["X", "@relay_vanguard", relayX?.href ?? "https://x.com/relay_vanguard"]
];
---
<BaseLayout
  title="Relay Vanguard | VRC Boxing 방송팀"
  description="Relay Vanguard는 팀장 유기프가 운영하는 한국어 VRC Boxing 방송팀입니다. VRChat 훈련, YouTube Shorts, X 공지, Reels 활동을 연결합니다."
>
  <header class="site-header">
    <a class="brand" href={base}>Relay Vanguard</a>
    <nav aria-label="Relay Vanguard 메뉴">
      <a href="#team">팀 소개</a>
      <a href="#vrcboxing">VRC Boxing</a>
      <a href="#operation">운영 방식</a>
      <a href="#media">미디어</a>
      <a href="#contact">문의</a>
    </nav>
  </header>

  <main class="relay-home-page">
    <section class="relay-home-hero" aria-labelledby="relay-title">
      <div class="relay-hero-copy">
        <p class="kicker">VRC Boxing Broadcast Team</p>
        <h1 id="relay-title">Relay Vanguard</h1>
        <p class="lead">
          팀장 유기프가 운영하는 한국어 VRC Boxing 방송팀. VRChat 훈련, 팀 공지,
          YouTube Shorts, Instagram Reels, X 기록을 한 흐름으로 연결한다.
        </p>
        <div class="hero-actions">
          {promotionLinks.map(([label, , href]) => (
            <a class={label === "YouTube" ? "button primary" : "button ghost"} href={href}>{label}</a>
          ))}
        </div>
      </div>
      <div class="relay-hero-stage" aria-label="Relay Vanguard 대표 이미지">
        <img class="relay-hero-main" src={heroImage} alt="Relay Vanguard VRC Boxing 썸네일" />
        <img class="relay-hero-logo" src={logoImage} alt="Relay Vanguard 로고" />
      </div>
    </section>

    <section class="relay-section relay-promo" aria-labelledby="promo-title">
      <div class="section-heading">
        <p class="kicker">Follow The Team</p>
        <h2 id="promo-title">X와 유튜브에서 이어진다</h2>
      </div>
      <div class="relay-channel-grid">
        {promotionLinks.map(([label, body, href]) => (
          <a href={href} rel={label === "X" || label === "Instagram" ? "me" : undefined}>
            <strong>{label}</strong>
            <span>{body}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="relay-section relay-team" id="team" aria-labelledby="team-title">
      <div class="section-heading">
        <p class="kicker">Team</p>
        <h2 id="team-title">팀장과 팀원</h2>
      </div>
      <div class="relay-member-grid">
        {teamMembers.map((member) => (
          <article>
            <span>{member.role}</span>
            <strong>{member.name}</strong>
            <p>{member.body}</p>
            <a href={member.href}>{member.cta}</a>
          </article>
        ))}
      </div>
    </section>

    <section class="relay-section relay-explain" id="vrcboxing" aria-labelledby="vrc-title">
      <div class="relay-principle-copy">
        <p class="kicker">What We Play</p>
        <h2 id="vrc-title">VRC Boxing이란</h2>
        <p>
          VRC Boxing은 VRChat 안에서 실제 몸 움직임을 이용해 복싱을 하는 활동이다.
          Relay Vanguard는 이 활동을 한국어 훈련, 방송 화면, 숏폼 편집에 맞게 풀어낸다.
        </p>
      </div>
      <div class="relay-character-panel">
        <img src={characterImage} alt="Relay Vanguard 캐릭터 비주얼" loading="lazy" />
      </div>
      <ul class="relay-principle-list">
        {vrcBoxingPoints.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="relay-section relay-reason" aria-labelledby="reason-title">
      <div class="section-heading">
        <p class="kicker">Why We Started</p>
        <h2 id="reason-title">방송팀을 만든 계기</h2>
      </div>
      <div class="relay-text-grid">
        {foundingReasons.map((reason) => (
          <article>
            <p>{reason}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="relay-section relay-loop" id="operation" aria-labelledby="operation-title">
      <div class="section-heading">
        <p class="kicker">How We Operate</p>
        <h2 id="operation-title">운영 방식</h2>
      </div>
      <ol class="relay-loop-list">
        {operatingLoop.map(([step, title, body]) => (
          <li>
            <span>{step}</span>
            <strong>{title}</strong>
            <p>{body}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="relay-section relay-showcase" id="media" aria-labelledby="media-title">
      <div class="section-heading">
        <p class="kicker">Actual Media</p>
        <h2 id="media-title">실제로 보여주는 것</h2>
      </div>
      <div class="relay-showcase-grid">
        {examples.map((example) => (
          <a class="relay-showcase-card" href={example.href}>
            <img src={example.image} alt={`${example.title} 미리보기`} loading="lazy" />
            <span>{example.label}</span>
            <strong>{example.title}</strong>
            <p>{example.body}</p>
            <em>{example.cta}</em>
          </a>
        ))}
      </div>
    </section>

    <section class="relay-section relay-contact" id="contact" aria-labelledby="contact-title">
      <div class="section-heading">
        <p class="kicker">Contact</p>
        <h2 id="contact-title">참가와 문의</h2>
      </div>
      <div class="relay-contact-panel">
        <p>
          참가 전에는 방송과 녹화에 들어갈 수 있다는 점, 닉네임/아바타/음성이 노출될 수 있다는 점,
          기본 매너와 스포츠맨십을 지키는 점을 먼저 확인한다.
        </p>
        <div class="relay-contact-grid">
          {contacts.map(([label, title, value]) => (
            <article>
              <span>{label}</span>
              <strong>{title}</strong>
              {value.startsWith("http") ? <a href={value}>바로가기</a> : <p>{value}</p>}
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
