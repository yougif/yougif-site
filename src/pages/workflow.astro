---
import BaseLayout from "../layouts/BaseLayout.astro";
import { workflowNotes } from "../data/yougif";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const loop = [
  ["01", "Record", "OBS와 플랫폼 VOD에서 원본을 남긴다."],
  ["02", "Score", "audio activity와 video motion으로 후보 구간을 고른다."],
  ["03", "Render", "1080x1920 세로 MP4와 PNG overlay 자막을 만든다."],
  ["04", "Review", "private 저장 후 제목, 설명, 재생목록, 움직임을 검수한다."],
  ["05", "Publish", "공개 가능한 결과만 Shorts/Reels와 링크 허브에 연결한다."]
];

const studioFeatures = [
  ["후보 플레이어", "숏츠와 포스터 후보를 한 화면에서 바로 재생하고 비교한다."],
  ["승인 게이트", "승인, 보류, 거절, 피드백을 로컬 sidecar에 저장해 중복 업로드를 막는다."],
  ["계정 연결 분리", "리뷰 모드는 토큰 없이 동작하고, 업로드는 사용자가 명시적으로 켠다."],
  ["저부하 학습", "PC가 바쁘지 않을 때만 로컬 메타데이터를 쌓아 후보 선별 기준을 개선한다."]
];
---
<BaseLayout title="Yougif Workflow | 운영 작업기" description="Yougif 방송, Relay Vanguard, Shorts 자동화 운영 작업기.">
  <header class="site-header">
    <a class="brand" href={base}>Yougif</a>
    <nav aria-label="Yougif Workflow 메뉴">
      <a href={base}>홈</a>
      <a href="#notes">기록</a>
      <a href="#loop">순서</a>
      <a href="#private">Private</a>
      <a href={`${base}#links`}>링크</a>
    </nav>
  </header>

  <main class="workflow-page">
    <section class="section research-hero workflow-hero" aria-labelledby="workflow-page-title">
      <div>
        <p class="kicker">Yougif Workflow</p>
        <h1 id="workflow-page-title">방송 운영을<br />기록으로 남긴다</h1>
        <p class="lead">
          유기프 방송, Relay Vanguard 훈련, Shorts 자동화 실험을 작업기 형태로 남긴다.
          공개 가능한 요약은 여기서 보고, 민감한 운영 메모는 Google 로그인 보호가 걸린 private 경로에 둔다.
        </p>
      </div>
    </section>

    <section class="section research-panel" id="notes" aria-labelledby="notes-title">
      <div class="section-heading">
        <p class="kicker">운영 기록</p>
        <h2 id="notes-title">최근 기록</h2>
      </div>
      <div class="workflow-note-grid">
        {workflowNotes.map((note) => (
          <article class="workflow-note">
            <div class="note-meta">
              <span>{note.date}</span>
              <strong>{note.tag}</strong>
            </div>
            <h3>{note.title}</h3>
            <p>{note.summary}</p>
            <ul>
              {note.points.map((point) => <li>{point}</li>)}
            </ul>
            <div class="note-actions">
              <span class="status-pill">{note.status}</span>
              {"href" in note && note.href && (
                <a class="button ghost" href={note.href}>자세히 보기</a>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section research-panel" id="loop" aria-labelledby="loop-title">
      <div class="section-heading">
        <p class="kicker">작업 루프</p>
        <h2 id="loop-title">영상이 기록이 되는 순서</h2>
      </div>
      <ol class="workflow-loop">
        {loop.map(([step, title, body]) => (
          <li>
            <span>{step}</span>
            <strong>{title}</strong>
            <p>{body}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="section research-panel creator-studio-showcase" id="creator-studio" aria-labelledby="creator-studio-title">
      <div class="section-heading">
        <p class="kicker">Creator Studio</p>
        <h2 id="creator-studio-title">토큰 없이 켜지는 로컬 리뷰 작업실</h2>
      </div>
      <div class="creator-studio-layout">
        <figure class="creator-studio-screen">
          <img src={`${base}assets/media/creator-studio-mockup.png`} alt="Yougif Creator Studio 현황판과 후보 플레이어 목업" />
          <figcaption>공개용 목업. 실제 후보 영상과 토큰 정보는 사이트에 포함하지 않는다.</figcaption>
        </figure>
        <div class="creator-studio-copy">
          <p>
            Yougif Creator Studio는 긴 방송 녹화본에서 만든 숏츠 후보, 썸네일, 포스터, 업로드 상태를
            한 곳에서 보는 로컬 작업실이다. 코드는 비공개 저장소에서 관리하고, 사이트에는 공개 가능한
            운영 방식과 결과만 소개한다.
          </p>
          <div class="creator-studio-feature-grid">
            {studioFeatures.map(([title, body]) => (
              <article>
                <strong>{title}</strong>
                <p>{body}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section research-panel private-workflow" id="private" aria-labelledby="private-title">
      <div class="section-heading">
        <p class="kicker">Private Notes</p>
        <h2 id="private-title">로그인 뒤 보는 운영 기록</h2>
      </div>
      <div class="private-panel">
        <div>
          <strong>Cloudflare Access로 보호할 경로</strong>
          <p>
            실제 private 작업기는 정적 사이트에 그대로 넣지 않고,
            Cloudflare Access에서 Google 로그인을 요구하는 경로로 분리한다.
          </p>
        </div>
        <a class="button primary" href={`${base}workflow-private/`}>Private Workflow 열기</a>
      </div>
      <p class="private-note">
        이 버튼은 보호 경로로 이동한다. Cloudflare Access 정책이 설정되기 전에는 이 경로를 공개 콘텐츠 저장소로 쓰지 않는다.
      </p>
    </section>
  </main>
</BaseLayout>
