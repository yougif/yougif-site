---
import BaseLayout from "../layouts/BaseLayout.astro";
import { channels, gallery, origin, profile, projects, workflow } from "../data/yougif";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const siteScript = `${base}scripts/site.js`;
---
<BaseLayout title="Yougif | 방송 허브">
  <header class="site-header">
    <a class="brand" href="#top" aria-label="유기프 홈">Yougif</a>
    <nav aria-label="주요 메뉴">
      <a href="#projects">프로젝트</a>
      <a href="#origin">이유</a>
      <a href="#gallery">갤러리</a>
      <a href="#workflow">흐름</a>
      <a href={`${base}workflow/`}>Workflow</a>
      <a href="#links">링크</a>
    </nav>
  </header>

  <main id="top">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="kicker">{profile.kicker}</p>
        <h1 id="hero-title">{profile.headline}</h1>
        <p class="lead">{profile.lead}</p>
        <div class="hero-actions">
          <a class="button primary" href="#projects">프로젝트 보기</a>
          <a class="button ghost" href={`${base}workflow/`}>작업기 보기</a>
        </div>
      </div>
      <div class="hero-visual" aria-label="유기프 대표 비주얼">
        <img src={profile.heroImage} alt="유기프 방송 대기화면" />
      </div>
    </section>

    <section class="section origin" id="origin" aria-labelledby="origin-title">
      <div class="section-heading">
        <p class="kicker">{origin.kicker}</p>
        <h2 id="origin-title">{origin.title}</h2>
      </div>
      <div class="origin-panel">
        <p>{origin.body}</p>
        <ul>
          {origin.points.map((point) => <li>{point}</li>)}
        </ul>
        <div class="origin-links" aria-label="참고 자료">
          {origin.references.map((reference) => (
            <a href={reference.href}>{reference.label}</a>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="projects" aria-labelledby="projects-title">
      <div class="section-heading">
        <p class="kicker">주요 활동</p>
        <h2 id="projects-title">프로젝트</h2>
      </div>
      <div class="project-grid">
        {projects.map((project) => (
          <button
            class="project-card"
            type="button"
            data-modal-title={project.title}
            data-modal-tag={project.tag}
            data-modal-detail={project.detail}
            data-modal-image={project.image}
          >
            <img src={project.image} alt="" loading="lazy" />
            <span>{project.tag}</span>
            <strong>{project.title}</strong>
            <p>{project.summary}</p>
          </button>
        ))}
      </div>
    </section>

    <section class="section split" id="gallery" aria-labelledby="gallery-title">
      <div class="section-heading">
        <p class="kicker">이미지 자료</p>
        <h2 id="gallery-title">갤러리</h2>
      </div>
      <div class="gallery-grid">
        {gallery.map((item) => (
          <button class="gallery-item" type="button" data-lightbox-src={item.src} data-lightbox-alt={item.alt}>
            <img src={item.src} alt={item.alt} loading="lazy" />
            <span>{item.label}</span>
          </button>
        ))}
      </div>
    </section>

    <section class="section workflow" id="workflow" aria-labelledby="workflow-title">
      <div class="section-heading">
        <p class="kicker">콘텐츠 흐름</p>
        <h2 id="workflow-title">운영 흐름</h2>
      </div>
      <ol class="flow-list">
        {workflow.map(([step, title, body]) => (
          <li><span>{step}</span><strong>{title}</strong><p>{body}</p></li>
        ))}
      </ol>
    </section>

    <section class="section automation" id="automation" aria-labelledby="automation-title">
      <div>
        <p class="kicker">자동화</p>
        <h2 id="automation-title">자동화 파이프라인</h2>
        <p>방송은 여러 플랫폼에 흩어져 있고, 녹화본과 썸네일은 로컬에 쌓인다. 유기프 사이트는 그 흐름을 공개 링크, 갤러리, 자동화 기록으로 묶는 허브 역할을 한다.</p>
        <div class="inline-actions">
          <a class="button ghost" href={`${base}workflow/`}>Yougif Workflow</a>
        </div>
      </div>
      <div class="pipeline" aria-label="자동화 파이프라인">
        <span>스캔</span>
        <span>점수화</span>
        <span>렌더링</span>
        <span>검토</span>
        <span>공개</span>
      </div>
    </section>

    <section class="section links" id="links" aria-labelledby="links-title">
      <div class="section-heading">
        <p class="kicker">공개 링크</p>
        <h2 id="links-title">채널 링크</h2>
      </div>
      <div class="link-row">
        {channels.map((channel) => (
          <a href={channel.href} rel="me">
            <strong>{channel.label}</strong>
            <span>{channel.note}</span>
          </a>
        ))}
      </div>
    </section>
  </main>

  <div class="modal" id="project-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div class="modal-panel">
      <button class="close-button" type="button" data-close-modal aria-label="상세 닫기">×</button>
      <img id="modal-image" alt="" />
      <p id="modal-tag" class="kicker"></p>
      <h2 id="modal-title"></h2>
      <p id="modal-detail"></p>
    </div>
  </div>

  <div class="modal" id="lightbox" aria-hidden="true" role="dialog" aria-modal="true" aria-label="갤러리 이미지 미리보기">
    <div class="modal-panel lightbox-panel">
      <button class="close-button" type="button" data-close-lightbox aria-label="이미지 닫기">×</button>
      <img id="lightbox-image" alt="" />
    </div>
  </div>

  <script src={siteScript} is:inline></script>
</BaseLayout>
