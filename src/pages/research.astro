---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const vketArticle =
  "https://vrcboxing.com/2026/02/06/%E5%BF%9C%E5%8B%9F%E7%B7%8F%E6%95%B0120%E5%90%8D%E3%80%80%E3%80%8Cvrcboxing-vket2025winter%E7%89%B9%E5%88%A5%E5%A4%A7%E4%BC%9A%E3%80%8D%E9%96%8B%E5%82%AC/";
const lilpaArticle =
  "https://vrcboxing.com/2026/02/06/%E8%B3%9E%E9%87%91100%E4%B8%87%E5%86%86%E8%A6%8F%E6%A8%A1-%E7%B7%8F%E8%A6%96%E8%81%B4%E8%80%85%E6%95%B08%E4%B8%87%E4%BA%BA-%E9%9F%93%E5%9B%BD%E3%81%AEvtuber%E4%B8%BB%E5%82%AC%E3%81%AE%E5%A4%A7/";

const metrics = [
  ["120", "Vket2025Winter special tournament applicants"],
  ["20+4", "qualifiers plus invited guests"],
  ["12", "main-stage matches"],
  ["8 teams", "Lilpa Boxing tournament structure"],
  ["5 days", "training period before the Lilpa event"],
  ["80k+", "reported total viewers / visitors for Lilpa Boxing"]
];

const evidenceCards = [
  {
    title: "Official VRC Boxing Hub",
    tag: "official",
    image: "https://vrcboxing.com/wp-content/uploads/2024/02/og_img.png",
    body:
      "공식 사이트는 VRC Boxing을 VRChat 기반 복싱 게임/대회 생태계로 정리하고, HOW TO PLAY와 NEWS를 통해 규칙과 이벤트를 계속 갱신한다.",
    href: "https://vrcboxing.com/"
  },
  {
    title: "Vket2025Winter Special Tournament",
    tag: "event scale",
    image: "https://vrcboxing.com/wp-content/uploads/2026/02/930946be39556ebc686ea689c3061fa1.png",
    body:
      "공식 뉴스 기준, Vket2025Winter 특별대회는 지원자 120명, 3개 부문, 본선 12경기, VR 관련 협찬 상품을 갖춘 행사로 공개됐다.",
    href: vketArticle
  },
  {
    title: "Lilpa Boxing Tournament",
    tag: "korea signal",
    image: "https://vr-lifemagazine.com/wp-content/uploads/2025/11/VRChat_2025-11-22_20-38-28.614_3840x2160-1024x576.jpg",
    body:
      "릴파 복싱은 한국 VTuber/스트리머 흐름과 VRC Boxing이 연결된 사례다. 공식 VRC Boxing 뉴스와 Virtual Life Magazine 모두 대회 규모와 팀 훈련 구조를 다뤘다.",
    href: lilpaArticle
  }
];

const modes = [
  ["Esports", "HP / STA / GUA", "자원 관리, 가드, 헤비펀치와 메가펀치 타이밍이 관전 포인트가 된다."],
  ["Real", "2 min / 3-down TKO", "폼, 너클 포인트, 실제 복싱에 가까운 판정이 훈련 콘텐츠로 이어진다."]
];

const relayPlan = [
  ["Practice", "짧게 치고 바로 복귀하는 좁은 공간용 기본기"],
  ["Broadcast", "다운, 회피, 가드 복귀, 코칭 장면을 방송 친화적으로 정리"],
  ["Shorts", "훈련 전후 변화와 한 기술 한 클립 구조로 Reels/Shorts화"],
  ["Archive", "공식 자료, 대회 영상, 팀 활동 기록을 분리해서 쌓기"]
];
---
<BaseLayout title="Yougif | VRC Boxing Research Digest" description="Visual digest of VRC Boxing signals for Yougif and Relay Vanguard.">
  <header class="site-header">
    <a class="brand" href={base}>Yougif</a>
    <nav aria-label="Research navigation">
      <a href={`${base}#origin`}>Why</a>
      <a href="#evidence">Evidence</a>
      <a href="#media">Media</a>
      <a href="#relay">Relay</a>
      <a href={`${base}#links`}>Links</a>
    </nav>
  </header>

  <main class="research-page">
    <section class="section research-hero visual-research-hero" aria-labelledby="research-title">
      <div>
        <p class="kicker">vrc boxing signal</p>
        <h1 id="research-title">VR 링 위에서 커지는 흐름</h1>
        <p class="lead">
          VRC Boxing은 경기, 훈련, 방송, 숏폼으로 이어지는 VRChat 기반 스포츠 콘텐츠다.
          Relay Vanguard는 그 흐름을 한국어권 팀 운영과 크리에이터 콘텐츠로 확장한다.
        </p>
      </div>
      <figure class="research-cover">
        <img
          src="https://vrcboxing.com/wp-content/uploads/2026/02/930946be39556ebc686ea689c3061fa1.png"
          alt="VRC Boxing Vket2025Winter special tournament visual"
        />
        <figcaption>Official VRC Boxing event signal</figcaption>
      </figure>
    </section>

    <section class="section research-panel" aria-labelledby="scoreboard-title">
      <div class="section-heading">
        <p class="kicker">why it matters</p>
        <h2 id="scoreboard-title">숫자로 보는 신호</h2>
      </div>
      <div class="scoreboard">
        {metrics.map(([value, label]) => (
          <div>
            <strong>{value}</strong>
            <span>{label}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="section research-panel" id="evidence" aria-labelledby="evidence-title">
      <div class="section-heading">
        <p class="kicker">public evidence</p>
        <h2 id="evidence-title">VRC Boxing이 이미 보여준 것</h2>
      </div>
      <div class="evidence-grid">
        {evidenceCards.map((card) => (
          <a class="evidence-card" href={card.href}>
            <img src={card.image} alt="" loading="lazy" />
            <span>{card.tag}</span>
            <strong>{card.title}</strong>
            <p>{card.body}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="section research-panel" id="media" aria-labelledby="media-title">
      <div class="section-heading">
        <p class="kicker">watch the format</p>
        <h2 id="media-title">영상으로 보는 구조</h2>
      </div>
      <div class="media-showcase">
        <article class="video-card">
          <iframe
            src="https://www.youtube.com/embed/vZ83iHKvjNI"
            title="VRC Boxing Vket2025Winter final broadcast"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
          <div>
            <strong>Vket2025Winter 본선</strong>
            <p>VRC Boxing 공식 뉴스에 임베드된 YouTube 경기 영상. 대회 운영, 카메라, 관전 포맷을 볼 수 있다.</p>
          </div>
        </article>
        <article class="video-card">
          <iframe
            src="https://vod.sooplive.co.kr/player/178649567/embed?showChat=false&amp;autoPlay=false&amp;mutePlay=false"
            title="Lilpa Boxing tournament day 1"
            loading="lazy"
            allow="clipboard-write; web-share"
            allowfullscreen
          ></iframe>
          <div>
            <strong>릴파 복싱 1일차</strong>
            <p>공식 VRC Boxing 뉴스가 연결한 SOOP 아카이브. 한국 스트리머 이벤트가 VRC Boxing과 만난 사례다.</p>
          </div>
        </article>
        <article class="video-card">
          <iframe
            src="https://vod.sooplive.co.kr/player/178748009/embed?showChat=false&amp;autoPlay=false&amp;mutePlay=false"
            title="Lilpa Boxing tournament day 2"
            loading="lazy"
            allow="clipboard-write; web-share"
            allowfullscreen
          ></iframe>
          <div>
            <strong>릴파 복싱 2일차</strong>
            <p>팀 단위 훈련과 본선 서사가 VRC Boxing 콘텐츠를 단발 이벤트 이상으로 확장할 수 있음을 보여준다.</p>
          </div>
        </article>
      </div>
    </section>

    <section class="section research-panel" aria-labelledby="rules-title">
      <div class="section-heading">
        <p class="kicker">how to play</p>
        <h2 id="rules-title">콘텐츠가 되는 규칙</h2>
      </div>
      <div class="mode-grid">
        {modes.map(([title, stat, body]) => (
          <article>
            <span>{stat}</span>
            <strong>{title}</strong>
            <p>{body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section research-panel" id="relay" aria-labelledby="relay-title">
      <div class="section-heading">
        <p class="kicker">relay vanguard translation</p>
        <h2 id="relay-title">유기프가 할 일</h2>
      </div>
      <ol class="relay-timeline">
        {relayPlan.map(([title, body]) => (
          <li>
            <strong>{title}</strong>
            <p>{body}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="section research-panel" aria-labelledby="refs-title">
      <div class="section-heading">
        <p class="kicker">source shelf</p>
        <h2 id="refs-title">더 깊게 보기</h2>
      </div>
      <div class="origin-links">
        <a href="https://github.com/yougif/vtuber-shorts/blob/main/docs/RESEARCH.md">Research archive</a>
        <a href="https://vrcboxing.com/">VRC Boxing official site</a>
        <a href="https://vrcboxing.com/howto/">VRC Boxing HOW TO PLAY</a>
        <a href={vketArticle}>Vket2025Winter official news</a>
        <a href={lilpaArticle}>Lilpa Boxing official news</a>
        <a href="https://vr-lifemagazine.com/vrc_lilpa-boxing_2025/">Lilpa Boxing feature article</a>
        <a href="https://www.yna.co.kr/view/AKR20260521039851073">Supplemental VR sports signal</a>
      </div>
    </section>
  </main>
</BaseLayout>
